Client

enum State {
CONNECTED
REGISTERED
CALLING
ANSWERING
TALKING
}

actions:

start() {
    this.setState(CONNECTED);
    this.register();
}

register() {
    sendRegisterMsgToServer(this);
}

getRegisterResponse(Response response) {
    if (response.errorCode == 0) {
        this.setState(REGISTERED);
    }
}

call(Client other) {
    if (this.state == REGISTERED) {
        this.setState(CALLING);
        sendCallHook(other);
    }
}

getIncomingCallHook(Hook hook) {
    if(this.state == REGISTERED) {
        this.setState(ANSWERING);
    } else {
        sendRejectHook(hook.otherClient);
    }
}

getRejectHook(Hook hook) {
    if (this.state == CALLING) {
        this.setState(REGISTERED);
    }
}

answer(Client other) {
    if (this.state == ANSWERING) {
        sendServerMsgStartCall(this, other);
    }
}

reject(Client other) {
    if (this.state == ANSWERING) {
        this.setState(REGISTERED);
        sendRejectHook(other);
    }
}

getStartCallHook(HookFromServer hook) {
    if (this.state == CALLING || this.state == ANSWERING) {
        this.setState(TALKING);
    }
}

endCall() {
    if (this.state == TALKING) {
        sendServerMsgEndCall();
    }
}

getEndCallHook(HookFromServer hook) {
    if (this.state == TALKING) {
        this.setState(REGISTERED);
    }
}
